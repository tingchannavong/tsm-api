generator client {
  provider = "prisma-client-js" // need to add -js
}

datasource db {
  provider = "mysql"
}

enum RoleType {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              Int             @id @default(autoincrement())
  username        String          @unique
  password        String
  email           String          @unique
  firstname       String
  lastname        String
  phone           String          @unique
  role            RoleType        @default(STAFF)
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt @db.Timestamp(0)
  createdOrders   Order[]         @relation("OrderCreatedBy")
  updatedOrders   Order[]         @relation("OrderUpdatedBy")
  updatedSessions SessionRecord[] @relation("SessionUpdatedBy")
  refreshTokens   RefreshToken[]
  securityStamp DateTime?
  // resetTokens     ResetToken[]
}

model Location {
  id          String          @id @default(uuid())
  name        String          @unique
  displayName String          @unique
  qrCode      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt @db.Timestamp(0)
  sessions    SessionRecord[]
}

enum SessionStatus {
  ACTIVE
  ENDED
  BILLED
  CANCELLED
}

model SessionRecord {
  id            Int           @id @default(autoincrement())
  groupId       String        @default(uuid())
  location      Location?     @relation(fields: [locationId], references: [id])
  locationId    String?
  name          String?
  startTime     DateTime      @default(now())
  endTime       DateTime?
  durationMin   Int?          @default(dbgenerated())
  status        SessionStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  pricing       Pricing?      @relation(fields: [pricingId], references: [id])
  pricingId     Int?
  orderDetail   OrderDetail?  @relation(fields: [orderDetailId], references: [id])
  orderDetailId Int?
  updatedBy     User?         @relation("SessionUpdatedBy", fields: [updatedById], references: [id])
  updatedById   Int?
  order         Order?        @relation(fields: [orderId], references: [id])
  orderId       Int?
}

model OrderDetail {
  id           Int             @id @default(autoincrement())
  displayName  String
  quantity     Int
  unitPrice    Decimal         @db.Decimal(10, 2)
  subTotal     Decimal         @db.Decimal(10, 2)
  currencyCode String          @db.Char(3)
  unit         String?
  basePrice    Decimal?        @db.Decimal(10, 2)
  durationMin  Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt @db.Timestamp(0)
  order        Order           @relation(fields: [orderId], references: [id]) // onDelete: Cascade maybe?
  orderId      Int
  sessions     SessionRecord[]
}

enum OrderStatus {
  PAID
  UNPAID
  CANCELLED
}

model Order {
  id           Int             @id @default(autoincrement())
  grandTotal   Decimal         @db.Decimal(10, 2)
  discount     Decimal?        @db.Decimal(10, 2)
  netTotal     Decimal         @db.Decimal(10, 2)
  status       OrderStatus     @default(PAID)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt @db.Timestamp(0)
  orderDetails OrderDetail[]
  createdBy    User?           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById  Int?
  updatedBy    User?           @relation("OrderUpdatedBy", fields: [updatedById], references: [id])
  updatedById  Int?
  sessions     SessionRecord[]
}

model Pricing {
  id         Int             @id @default(autoincrement())
  name       String          @unique
  price      Decimal         @db.Decimal(10, 2)
  unit       Unit?           @relation(fields: [unitId], references: [id])
  unitId     Int?
  currency   Currency?       @relation(fields: [currencyId], references: [id])
  currencyId Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt @db.Timestamp(0)
  sessions   SessionRecord[]
}

model Unit {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  pricings Pricing[]
}

model Currency {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  code     String    @unique @db.Char(3)
  symbol   String    @unique @db.VarChar(10)
  pricings Pricing[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String
  userAgent String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

