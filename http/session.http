@BASE_URL = http://localhost:9999
@ACCESS_TOKEN = {{login.response.body.access_token}}
@locationId=c2a40b6a-64c6-4d5c-88c6-471ccdaa327b
@groupId=9a071ddb-5d94-4d2b-a8ad-1367360cea72
@LOC2=14f66239-de40-4575-aea1-f7d7405b4695
@LOC3=421602e9-efda-4229-922f-f3e0b032b47a
@RockyGROUP=092e9bc0-6cb7-4c94-9461-11797cbc3d0d
### Login
# @name login
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
    "username": "superadmin",
    "password": "admin88"
}

### Get filtered session
GET {{BASE_URL}}/api/sessions/filter?locationId={{LOC3}}&groupId={{RockyGROUP}}

### Get all sessions
# locationId={{locationId}}&groupId={{groupId}}
# GET {{BASE_URL}}/api/sessions
GET {{BASE_URL}}/api/sessions?status=BILLED
Authorization: Bearer {{ACCESS_TOKEN}}

### Create session
POST {{BASE_URL}}/api/sessions
Content-Type: application/json

{
    "locationId": "c2a40b6a-64c6-4d5c-88c6-471ccdaa327b", 
    "groupId": null, 
    "people": 4,
    "pricingId": 1
}

### Get session by Id
GET {{BASE_URL}}/api/sessions/45

### Update session by Id
PATCH {{BASE_URL}}/api/sessions/38
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
    "name": "Guilt"
}

# {
