@BASE_URL = http://localhost:9999
@ACCESS_TOKEN = {{login.response.body.access_token}}
@locationId=c2a40b6a-64c6-4d5c-88c6-471ccdaa327b
@groupId=9a071ddb-5d94-4d2b-a8ad-1367360cea72
@LOC2=14f66239-de40-4575-aea1-f7d7405b4695
### Login
# @name login
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
    "username": "superadmin",
    "password": "admin88"
}

### Create session
POST {{BASE_URL}}/api/sessions
Content-Type: application/json

{
    "locationId": "c2a40b6a-64c6-4d5c-88c6-471ccdaa327b", 
    "groupId": null, 
    "name1": "drew",
    "name2": "",
    "people": -1,
    "pricingId": 1
}

### Get filtered session
GET {{BASE_URL}}/api/sessions/filter?locationId={{locationId}}

### Get all sessions
# GET {{BASE_URL}}/api/sessions
GET {{BASE_URL}}/api/sessions?locationId={{locationId}}&groupId={{groupId}}&status=ACTIVE
Authorization: Bearer {{ACCESS_TOKEN}}

### Get session by Id
GET {{BASE_URL}}/api/sessions/25


### Update session by Id
PATCH {{BASE_URL}}/api/sessions/30
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
    "status": "ENDED", 
    "endTime": "2026-03-25T09:32:09.345Z",
    "name": "Prince"
}

# patch later
# { locationId, groupId, pricingId }

### Delete session by Id
DELETE {{BASE_URL}}/api/sessions/1
Authorization: Bearer {{ACCESS_TOKEN}}

### Update session by Group
PATCH {{BASE_URL}}/api/sessions/groups/{{groupId}}
Authorization: Bearer {{ACCESS_TOKEN}}

{
    "status": "ENDED", 
    "startTime": null, 
    "endTime": null,
}

