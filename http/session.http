@BASE_URL = http://localhost:9999
@ACCESS_TOKEN = {{login.response.body.access_token}}
@locationId=c2a40b6a-64c6-4d5c-88c6-471ccdaa327b
@groupId=9a071ddb-5d94-4d2b-a8ad-1367360cea72
@LOC2=14f66239-de40-4575-aea1-f7d7405b4695
@RockyGROUP=9a071ddb-5d94-4d2b-a8ad-1367360cea72
### Login
# @name login
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
    "username": "superadmin",
    "password": "admin88"
}

### Get filtered session
GET {{BASE_URL}}/api/sessions/filter?locationId={{locationId}}

### Get all sessions
# locationId={{locationId}}&groupId={{groupId}}
# GET {{BASE_URL}}/api/sessions
GET {{BASE_URL}}/api/sessions?status=ENDED
Authorization: Bearer {{ACCESS_TOKEN}}

### Create session
POST {{BASE_URL}}/api/sessions
Content-Type: application/json

{
    "locationId": "c2a40b6a-64c6-4d5c-88c6-471ccdaa327b", 
    "groupId": null, 
    "name1": "mac",
    "name2": "samsung",
    "names": ["becky", "yaya", "pat" ],
    "people": 3,
    "pricingId": 1
}

### Get session by Id
GET {{BASE_URL}}/api/sessions/39

### Update session by Id
PATCH {{BASE_URL}}/api/sessions/43
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
    "name": "Guilt"
}

# {
#     "status": "ENDED", 
#     "endTime": "2026-03-26T05:36:00.000Z",
#     "name": "Dara"
    # "pricingId": 1
# }

# patch later
# { locationId, groupId, pricingId }

### Delete session by Id
DELETE {{BASE_URL}}/api/sessions/1
Authorization: Bearer {{ACCESS_TOKEN}}

### Update session by Group
# TO DO: add start time patch later
PATCH {{BASE_URL}}/api/sessions/groups/05b78d8b-1e83-43cc-9839-5873be495ddb
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
    "status": "ENDED", 
    "endTime": "2026-03-28T11:01:00.000Z"
}

